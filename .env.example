# Host port to publish Cinny on.
HOST_PORT=8095

# Optional manual override: your homeserver's domain (e.g. matrix.example.com).
# Leave blank to let entrypoint.sh try Docker-socket auto-detection instead
# (see README.md) -- and if that finds nothing either, Cinny still lets
# anyone using it type in a homeserver by hand on the login screen.
HOMESERVER_URL=
